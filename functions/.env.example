# Lambda deployment environment variables.
# Copy this file to .env.prod / .env.dev (kept out of git) and fill in real
# values — deploy.sh sources .env.<stage> based on the --stage flag.

# R2 Configuration for Lambda Functions
# Copy these values from your main Laravel .env file

CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_ACCOUNT_ID=
CF_R2_BUCKET=
CF_R2_ENDPOINT=

# AWS Configuration (for fallback)
AWS_BUCKET=
AUDIO_PROCESSING_BUCKET=
